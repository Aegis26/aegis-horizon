# Runtime
NODE_ENV=development
PORT=8080
BASE_PATH=/
APP_URL=http://localhost:5173
LOG_LEVEL=info
# Optional override when the API starts outside the repository root
CRM_DIST_DIR=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/aegis_horizon

# Clerk authentication
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Replit-managed production deployments set these proxy paths automatically.
# Leave them empty for a directly managed external Clerk instance.
CLERK_PROXY_URL=
VITE_CLERK_PROXY_URL=

# Server-side encryption and sessions
SESSION_SECRET=replace_with_a_long_random_secret
# Optional dedicated 32-byte base64 key. If omitted, a domain-separated key is
# derived from SESSION_SECRET.
WEBHOOK_ENCRYPTION_KEY=

# Email
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Aegis Horizon <notifications@example.com>

# Anthropic through Replit AI Integrations
AI_INTEGRATIONS_ANTHROPIC_API_KEY=replace_me
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Replit App Storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replace_me
PRIVATE_OBJECT_DIR=/private
PUBLIC_OBJECT_SEARCH_PATHS=/public

# Replit Connectors (injected automatically on Replit)
REPLIT_CONNECTORS_HOSTNAME=
REPL_IDENTITY=
WEB_REPL_RENEWAL=